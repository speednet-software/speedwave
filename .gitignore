# Rust / Cargo
target/
**/*.rs.bk
# Per-machine cargo overrides (linker path, etc.) — template in
# docs/contributing/development-setup.md. `config.local.toml` is not a
# cargo convention but listed for users who follow the docs anyway.
.cargo/config.toml
.cargo/config.local.toml

# Node.js (root-level lockfiles if any)
node_modules/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code
.claude/*.lock
.claude/worktrees/

# Superpowers skills (local tooling, not part of the project)
docs/superpowers/

# Environment / secrets
.env
.env.*
!.env.example

# Tauri signing keys
.tauri-privkey
.tauri-privkey.pub
.tauri-pubkey

# Code signing credentials — MUST NEVER be committed
*.p12
*.pfx
*.cer
*.p8
*.key
*.csr
*.p12.base64
*.pfx.base64
apple-signing/
azure-signing/

# Speedwave runtime data (should never be committed)
.speedwave/

# Worktree metadata
.worktree.json

# Coverage
coverage/
*.lcov
*.profraw

# Swift Package Manager
.build/
.swiftpm/

# Build artifacts
*.dmg
*.exe
*.msi
*.deb

# Bundled Lima binaries (downloaded by `make download-lima`)
desktop/src-tauri/lima/
desktop/src-tauri/THIRD-PARTY-LICENSES/

# Bundled Node.js binary (downloaded by `make download-nodejs`)
desktop/src-tauri/nodejs/

# Reserved nerdctl-full bundle layout — not currently populated in production,
# kept so resolve_binary() can fall through to it if tests drop a tree here.
desktop/src-tauri/nerdctl-full/

# Bundled WSL2 resources (downloaded by `make download-wsl-resources`, Windows only)
desktop/src-tauri/wsl/

# Bundled macOS native CLI helpers (compiled by `make build-native-macos`)
desktop/src-tauri/calendar-cli
desktop/src-tauri/mail-cli
desktop/src-tauri/notes-cli
desktop/src-tauri/reminders-cli
desktop/src-tauri/audio-capture-cli

# Bundled container build context + host workers (mcp-os, oauth) — staged before Tauri build
desktop/src-tauri/build-context/
desktop/src-tauri/mcp-os/
desktop/src-tauri/oauth/
.e2e-artifacts/

# Local Python venvs (test tooling)
.office-test-venv/

# Python bytecode caches
__pycache__/
*.pyc
