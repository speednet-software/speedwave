
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder

WORKDIR /build

COPY tsconfig.base.json package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY policies/package.json ./policies/
COPY hub/package.json ./hub/
RUN --mount=type=cache,target=/root/.npm npm ci --workspace=hub --ignore-scripts

COPY shared/src ./shared/src
COPY shared/tsconfig.json ./shared/
RUN npm run build --workspace=shared

COPY policies/wasm-pkg ./policies/wasm-pkg

COPY policies/src ./policies/src
COPY policies/tsconfig.json ./policies/
COPY policies/templates ./policies/templates
RUN cd policies && npx tsc

COPY hub/src ./hub/src
COPY hub/tsconfig.json ./hub/
RUN npm run build --workspace=hub

RUN npm prune --omit=dev --workspace=hub --ignore-scripts

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

RUN apk add --no-cache curl tzdata

WORKDIR /app

COPY --from=builder /build/shared/dist ./shared/dist
COPY --from=builder /build/shared/package.json ./shared/
COPY --from=builder /build/node_modules ./node_modules

COPY --from=builder /build/policies/dist ./policies/dist
COPY --from=builder /build/policies/templates ./policies/templates
COPY --from=builder /build/policies/wasm-pkg ./policies/wasm-pkg
COPY --from=builder /build/policies/package.json ./policies/

COPY --from=builder /build/hub/package.json ./
COPY --from=builder /build/hub/dist ./dist

RUN mkdir -p /context && chown -R node:node /context /app

USER node

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:3000/health || exit 1

EXPOSE 3000

ENV PORT=3000 \
    NODE_ENV=production

CMD ["node", "dist/index.js"]
