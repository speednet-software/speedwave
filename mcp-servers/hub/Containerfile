# Speedwave MCP Hub - Orchestrator
# Routes requests to isolated MCP workers via HTTP bridge
#
# Security:
# - NO tokens - hub only orchestrates
# - NO direct API access - all via HTTP bridge to workers
# - Blast radius: compromise of hub exposes NO service credentials

# Build stage
FROM node:24-alpine@sha256:fb71d01345f11b708a3553c66e7c74074f2d506400ea81973343d915cb64eef0 AS builder

WORKDIR /build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Build shared library first (dependency)
# ─────────────────────────────────────────────────────────────────────────────
COPY tsconfig.base.json ./
COPY shared/package*.json ./shared/
RUN --mount=type=cache,target=/root/.npm cd shared && npm install

COPY shared/src ./shared/src
COPY shared/tsconfig.json ./shared/
RUN cd shared && npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Build policies (imports from ../shared/dist; hub imports from ../policies/dist)
# ─────────────────────────────────────────────────────────────────────────────
COPY policies/package*.json ./policies/
RUN --mount=type=cache,target=/root/.npm cd policies && npm install

COPY policies/src ./policies/src
COPY policies/tsconfig.json ./policies/
COPY policies/templates ./policies/templates
RUN cd policies && npm run build

# Prebuilt on the host (build-wasm.sh, now mandatory in bundle-build-context) and staged by
# bundle-build-context; alpine has no Rust/wasm-pack, so it is only copied here, never built.
# Unused by policies' `npm run build` (plain tsc) — placed after it so a wasm content change
# doesn't invalidate the tsc build layer's cache.
COPY policies/wasm-pkg ./policies/wasm-pkg

# ─────────────────────────────────────────────────────────────────────────────
# Stage 3: Build hub (imports from ../shared/dist and ../policies/dist)
# ─────────────────────────────────────────────────────────────────────────────
COPY hub/package*.json ./hub/
RUN --mount=type=cache,target=/root/.npm cd hub && npm install

COPY hub/src ./hub/src
COPY hub/tsconfig.json ./hub/
RUN cd hub && npm run build

# Prune devDependencies
RUN cd hub && npm prune --omit=dev

# Production stage
FROM node:24-alpine@sha256:fb71d01345f11b708a3553c66e7c74074f2d506400ea81973343d915cb64eef0

# curl for healthcheck; tzdata for TZ env — keep aligned with tz.rs (see CLAUDE.md SSOT).
RUN apk add --no-cache curl tzdata

WORKDIR /app

# Copy built shared library (required at runtime for relative imports)
COPY --from=builder /build/shared/dist ../shared/dist
COPY --from=builder /build/shared/package.json ../shared/
COPY --from=builder /build/shared/node_modules ../shared/node_modules

# Copy built policies library (required at runtime for relative imports + template loading)
COPY --from=builder /build/policies/dist ../policies/dist
COPY --from=builder /build/policies/templates ../policies/templates
# Unused by the hub yet (F3.4 wires the executor to it) — shipped so the image already
# carries it once consumed, without a second image retag.
COPY --from=builder /build/policies/wasm-pkg ../policies/wasm-pkg
COPY --from=builder /build/policies/package.json ../policies/
COPY --from=builder /build/policies/node_modules ../policies/node_modules

# Copy built hub application
COPY --from=builder /build/hub/package*.json ./
COPY --from=builder /build/hub/dist ./dist
COPY --from=builder /build/hub/node_modules ./node_modules

# Create directories
RUN mkdir -p /context && chown -R node:node /context /app /app/../shared /app/../policies

# Security: non-root user
USER node

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:3000/health || exit 1

EXPOSE 3000

ENV PORT=3000 \
    NODE_ENV=production

CMD ["node", "dist/index.js"]
