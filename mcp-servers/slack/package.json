{
  "name": "@speedwave/mcp-slack",
  "version": "0.13.3",
  "description": "Speedwave MCP Slack Worker - Isolated Slack API access",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "speedwave",
    "mcp",
    "slack",
    "worker"
  ],
  "author": "Speednet",
  "license": "Apache-2.0",
  "dependencies": {
    "@slack/web-api": "^7.17.0",
    "@speedwave/mcp-shared": "file:../shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-prettier": "^5.1.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.0.16"
  }
}
