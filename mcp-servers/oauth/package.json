{
  "name": "@speedwave/mcp-oauth",
  "version": "0.15.0",
  "description": "Speedwave oauth Worker — per-project host-side OAuth refresh proxy (ADR-060). Not visible to Claude; only called by other workers in the same project.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "speedwave",
    "mcp",
    "oauth",
    "worker",
    "refresh"
  ],
  "author": "Speednet",
  "license": "Apache-2.0",
  "dependencies": {
    "@speedwave/mcp-shared": "file:../shared"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^25.5.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-prettier": "^5.1.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.0.16"
  }
}
