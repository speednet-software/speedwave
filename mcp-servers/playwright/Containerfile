
FROM mcr.microsoft.com/playwright:v1.59.1-jammy@sha256:8a0360d39d1973be506dd59002904a774f6d697d4946c94063b3fd006461c8ff

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/playwright-mcp

COPY playwright/package.json playwright/package-lock.json ./

RUN npm ci --omit=dev \
    && npm cache clean --force

RUN sed -i 's/mcpServer\.connect(serverBackendFactory, transport, true)/mcpServer.connect(serverBackendFactory, transport, false)/' \
       node_modules/playwright-core/lib/tools/utils/mcp/http.js \
    && grep -q 'mcpServer.connect(serverBackendFactory, transport, false)' \
       node_modules/playwright-core/lib/tools/utils/mcp/http.js \
    || (echo "FATAL: heartbeat patch did not apply, verify the playwright-core path for the @playwright/mcp version pinned in package-lock.json" && exit 1)

USER pwuser

WORKDIR /home/pwuser

ENV PORT=3000 \
    NODE_ENV=production

EXPOSE 3000


CMD ["sh", "-c", "trap 'exit 0' TERM INT; /opt/playwright-mcp/node_modules/.bin/playwright-mcp \
     --host 0.0.0.0 \
     --port 3000 \
     --browser chromium \
     --executable-path /ms-playwright/chromium_headless_shell-1217/chrome-linux/headless_shell \
     --user-data-dir /tmp/playwright-mcp-userdata \
     --output-dir /tmp/playwright-mcp-output \
     --allowed-hosts '*' \
     --headless \
     --no-sandbox & wait $!"]
