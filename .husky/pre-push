#!/usr/bin/env sh
# `git push` exports GIT_DIR / GIT_WORK_TREE / GIT_INDEX_FILE pointing at the
# pushing repo; strip them so any git-touching command below (current or future)
# sees a clean, hook-independent environment, not the leaked push-time state.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_REFLOG_ACTION GIT_PREFIX

# Fast format-only gate. The full test suite is the required CI gate on every
# PR to dev/main (macOS + Windows); running it locally would only duplicate CI.
make check-fmt
