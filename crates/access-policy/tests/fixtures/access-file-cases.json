[
  {
    "name": "all full file",
    "text": "{\"version\":1,\"default\":\"full\",\"services\":{}}",
    "expected": {
      "default": "full",
      "services": {}
    }
  },
  {
    "name": "mode of one service",
    "text": "{\"version\":1,\"default\":\"full\",\"services\":{\"slack\":\"read_only\"}}",
    "expected": {
      "default": "full",
      "services": {
        "slack": "read_only"
      }
    }
  },
  {
    "name": "read-only default",
    "text": "{\"version\":1,\"default\":\"read_only\",\"services\":{\"slack\":\"full\"}}",
    "expected": {
      "default": "read_only",
      "services": {
        "slack": "full"
      }
    }
  },
  {
    "name": "default and services are optional",
    "text": "{\"version\":1}",
    "expected": {
      "default": "full",
      "services": {}
    }
  },
  {
    "name": "plugin style service ids",
    "text": "{\"version\":1,\"services\":{\"custom-my-mcp\":\"read_only\",\"os-mail\":\"read_only\",\"figma\":\"full\"}}",
    "expected": {
      "default": "full",
      "services": {
        "custom-my-mcp": "read_only",
        "os-mail": "read_only",
        "figma": "full"
      }
    }
  },
  {
    "name": "service id of 64 characters",
    "text": "{\"version\": 1, \"services\": {\"abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\": \"read_only\"}}",
    "expected": {
      "default": "full",
      "services": {
        "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb": "read_only"
      }
    }
  },
  {
    "name": "256 services",
    "generate": {
      "services": 256
    },
    "expected_service_count": 256
  },
  {
    "name": "257 services",
    "generate": {
      "services": 257
    },
    "error": true
  },
  {
    "name": "file over 65536 bytes",
    "generate": {
      "padding": 65537
    },
    "error": true
  },
  {
    "name": "service id of 65 characters",
    "text": "{\"version\": 1, \"services\": {\"abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\": \"read_only\"}}",
    "error": true
  },
