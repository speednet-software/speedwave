# Speedwave E2E — SSH targets for remote test machines.
# Copy to .env and fill in your values. .env is gitignored.

# Format: user@host (IP or hostname)
SPEEDWAVE_WINDOWS_HOST=user@hostname
SPEEDWAVE_MACOS_HOST=user@hostname

# Optional: non-default SSH port for Windows (default: 22)
# SPEEDWAVE_WINDOWS_SSH_PORT=22

# Optional: WSL2 distro name on the Windows machine (default: Ubuntu-22.04)
# SPEEDWAVE_WINDOWS_WSL_DISTRO=Ubuntu-22.04

# Optional: override repo root for e2e-vm.sh (default: auto-detected from git)
# SPEEDWAVE_REPO_DIR=/path/to/speedwave

# --- E2E LLM provider config (desktop/e2e/helpers/llm.ts) ---
# Required by the chat / provider specs. No fallbacks: specs fail if unset.

# OpenRouter provider (priced) — a cheap, deterministic, instruction-following model.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local OpenAI-compatible LLM server (unpriced) for the local-provider specs.
LOCAL_LLM_BASE_URL=http://host:port
LOCAL_LLM_API_KEY=sk-...
LOCAL_LLM_MODEL=vendor/model-id
