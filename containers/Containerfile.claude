# OCI Containerfile for Speedwave Claude container. Base: node:24-bookworm-slim (Debian).
# Multi-arch: linux/amd64 + linux/arm64 (Apple Silicon)
FROM node:24-bookworm-slim@sha256:2c87ef9bd3c6a3bd4b472b4bec2ce9d16354b0c574f736c476489d09f560a203

# Security: user is set via compose `user:` "1000:1000" (containerd runs as root inside the Lima/WSL2
# VM). Base image already has uid/gid 1000; rootless BuildKit can't rename it (see consts.rs::CONTAINER_USER_UNPRIVILEGED).
ENV HOME=/home/speedwave
RUN mkdir -p /home/speedwave && chown 1000:1000 /home/speedwave

# No --force-unsafe-io: under nested virt a layer snapshot can commit an unpacked
# file before its data is flushed, baking 0-byte binaries into the image (torn git).
RUN apt-get update -o Acquire::Retries=3 && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        jq \
        ncurses-term \
        python3 \
        python3-pip \
        python3-venv \
        tzdata \
        wget \
    && rm -rf /var/lib/apt/lists/*

# Separate layer: catch torn/empty binaries from the unpack above at build time.
RUN git --version && jq --version && python3 --version && curl --version >/dev/null

# Create directories for resources (read-only mount point)
RUN mkdir -p /speedwave/resources && \
    chown -R 1000:1000 /speedwave

# Create workspace directory (read-only mount point for project)
RUN mkdir -p /workspace && \
    chown 1000:1000 /workspace

# Install Claude Code as speedwave user, then copy binary to image layer: /home/speedwave is a
# VirtioFS mount at runtime, and reading the ~210MB binary through it causes a ~10s freeze.

# Copy reusable installer (DRY — also used by entrypoint.sh at runtime)
COPY --chmod=755 install-claude.sh /usr/local/bin/install-claude.sh

# Required — no default intentional (fail-closed; must be passed via --build-arg)
ARG CLAUDE_VERSION
USER 1000
# The official installer downloads the binary from GCS and verifies its SHA256
# against a version-pinned manifest.json. See install-claude.sh for details.
RUN /usr/local/bin/install-claude.sh "${CLAUDE_VERSION}"
USER root
RUN CLAUDE_BIN=$(readlink -f /home/speedwave/.local/bin/claude) && \
    cp "$CLAUDE_BIN" /usr/local/bin/claude && \
    chmod +x /usr/local/bin/claude && \
    rm -rf /home/speedwave/.local/share/claude && \
    rm -f /home/speedwave/.local/bin/claude && \
    ln -sf /usr/local/bin/claude /home/speedwave/.local/bin/claude

# OSC 52 clipboard wrappers — six symlinks to one script. Claude Code copies via wl-copy/xclip/xsel
# (probe gated on WAYLAND_DISPLAY, defaults.rs::base_env) or powershell.exe on Windows. ADR-052.
COPY --chmod=755 osc52-copy.sh /usr/local/bin/osc52-copy.sh
RUN ln -s osc52-copy.sh /usr/local/bin/pbcopy && \
    ln -s osc52-copy.sh /usr/local/bin/xclip && \
    ln -s osc52-copy.sh /usr/local/bin/xsel && \
    ln -s osc52-copy.sh /usr/local/bin/wl-copy && \
    ln -s osc52-copy.sh /usr/local/bin/clip.exe && \
    ln -s osc52-copy.sh /usr/local/bin/powershell.exe

# TypeScript language server for the typescript-lsp plugin (Apache-2.0): the plugin only ships an
# lspServers metadata entry pointing at the bare command; baking it into /usr/local puts it on PATH.
# Tarballs are fetched via `npm pack` and SHA256-verified before install, matching this file's
# SHA256-verified download convention rather than trusting the registry response outright.
ARG TS_LANGUAGE_SERVER_VERSION=5.3.0
ARG TYPESCRIPT_VERSION=6.0.3
ARG TS_LANGUAGE_SERVER_SHA256=398cacc17fff2108652e7b4050e3182008d17063246b3fea7dcf5fae2ce1560e
ARG TYPESCRIPT_SHA256=33cd0ee1beaa8c9e9d15a9da836c62ddea4c34a42d7c2d349dbc80d94165d22a
RUN NPM_PACK_DIR=$(mktemp -d) && \
    cd "$NPM_PACK_DIR" && \
    npm pack "typescript-language-server@${TS_LANGUAGE_SERVER_VERSION}" "typescript@${TYPESCRIPT_VERSION}" && \
    echo "${TS_LANGUAGE_SERVER_SHA256}  typescript-language-server-${TS_LANGUAGE_SERVER_VERSION}.tgz" | sha256sum -c - && \
    echo "${TYPESCRIPT_SHA256}  typescript-${TYPESCRIPT_VERSION}.tgz" | sha256sum -c - && \
    npm install -g \
        "${NPM_PACK_DIR}/typescript-language-server-${TS_LANGUAGE_SERVER_VERSION}.tgz" \
        "${NPM_PACK_DIR}/typescript-${TYPESCRIPT_VERSION}.tgz" && \
    npm cache clean --force && \
    rm -rf "$NPM_PACK_DIR"

# Copy entrypoint late to avoid busting the ~210MB Claude Code layer cache
COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh

# Final: run as unprivileged user
USER 1000
WORKDIR /home/speedwave

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
