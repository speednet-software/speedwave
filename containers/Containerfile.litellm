# OCI Containerfile for the Speedwave LiteLLM proxy (ADR-072)
# Base: python:3.13-slim-bookworm (Debian)
# Multi-arch: linux/amd64 + linux/arm64 (Apple Silicon)
#
# Supply-chain posture (the reason ADR-040 removed LiteLLM, mitigated here):
# - exact version pin with --require-hashes (containers/litellm/requirements.txt,
#   generated from requirements.in — see the bump procedure there)
# - built locally by the Speedwave build pipeline (pull_policy: never)
# - no Admin UI, no database, no host port; reachable only on the per-project
#   compose network
FROM python:3.13-slim-bookworm

# Security: container user is set via compose `user:` field to "1000:1000".
# See Containerfile.claude for the rootless-BuildKit rationale.
ENV HOME=/home/speedwave
RUN mkdir -p /home/speedwave && chown 1000:1000 /home/speedwave

# tzdata: required by the host-TZ injection contract (CLAUDE.md SSOT alignment
# for tz.rs::detect_host_timezone) so log timestamps carry the host offset.
RUN apt-get update -o Acquire::Retries=3 && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        -o Dpkg::Options::="--force-unsafe-io" \
        ca-certificates \
        curl \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

# Hash-verified, fully pinned dependency set. --no-deps is implied by
# --require-hashes (every transitive dep is already in the lock).
COPY litellm/requirements.txt /opt/speedwave/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /opt/speedwave/requirements.txt

# Usage callback (PYTHONPATH so `litellm_callback.speedwave_usage_logger`
# resolves from config.yaml) + entrypoint.
COPY litellm/litellm_callback.py /opt/speedwave/litellm_callback.py
COPY litellm/entrypoint.sh /opt/speedwave/entrypoint.sh
RUN chmod 0755 /opt/speedwave/entrypoint.sh && \
    chown -R 1000:1000 /opt/speedwave
ENV PYTHONPATH=/opt/speedwave

# Mount points: config (ro), per-provider tokens (ro), usage sink (rw).
RUN mkdir -p /config /tokens /usage && chown 1000:1000 /config /tokens /usage

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:4000/health/liveliness || exit 1

ENTRYPOINT ["/opt/speedwave/entrypoint.sh"]
